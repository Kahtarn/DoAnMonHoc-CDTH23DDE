<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/EditProfileUser"
    android:layout_width="match_parent"
    android:fitsSystemWindows="true"
    android:layout_height="match_parent"
    tools:context=".ui.auth.EditProfileUser">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/appBarLayoutEdit">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_gradient">

            <ImageButton
                android:id="@+id/btnBackHome"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_gradient"
                android:src="@drawable/ic_arrow_back"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="56dp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Chỉnh Sửa Thông tin"
                android:textSize="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.009"
                app:layout_constraintStart_toEndOf="@+id/btnBackHome"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <EditText
        android:id="@+id/edtFullNameUser"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_rounded_input"
        app:layout_constraintStart_toStartOf="@+id/tvFullName"
        app:layout_constraintTop_toBottomOf="@+id/tvFullName" />

    <TextView
        android:id="@+id/tvFullName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Họ và tên:"
        android:textSize="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/appBarLayoutEdit"/>

    <TextView
        android:id="@+id/tvEditPosition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Tỉnh:"
        app:layout_constraintStart_toStartOf="@+id/edtFullNameUser"
        app:layout_constraintTop_toBottomOf="@+id/edtFullNameUser" />
    <Spinner
        android:id="@+id/sPositionProvinceName"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_rounded_input"
        app:layout_constraintTop_toBottomOf="@id/tvEditPosition"
        app:layout_constraintStart_toStartOf="@id/tvEditPosition"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/tvEditWardName"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/sPositionProvinceName"
        app:layout_constraintStart_toStartOf="@id/sPositionProvinceName"
        android:text="Huyện:"
        />
    <Spinner
        android:id="@+id/sPositionWardName"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_rounded_input"
        app:layout_constraintStart_toStartOf="@id/tvEditWardName"
        app:layout_constraintTop_toBottomOf="@id/tvEditWardName"
        />

    <TextView
        android:id="@+id/tvEditGender"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="20dp"
        android:text="Giới tính:"
        android:textSize="15dp"
        app:layout_constraintStart_toStartOf="@+id/sPositionWardName"
        app:layout_constraintTop_toBottomOf="@id/sPositionWardName" />

    <RadioGroup
        android:id="@+id/rgGenderEdit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/tvEditGender"
        app:layout_constraintStart_toEndOf="@+id/tvEditGender"
        app:layout_constraintTop_toTopOf="@+id/tvEditGender"
        android:orientation="horizontal"
        >
        <RadioButton
            android:id="@+id/rbtnEditNam"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Nam" />

        <RadioButton
            android:id="@+id/rbtnEditNu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Nữ" />
    </RadioGroup>
    <TextView
        android:id="@+id/tvEditPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Số điện thoại:"
        android:layout_margin="16dp"
        android:textSize="15dp"
        app:layout_constraintStart_toStartOf="@id/tvEditGender"
        app:layout_constraintTop_toBottomOf="@id/tvEditGender"
        />
    <EditText
        android:id="@+id/edtPhone"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_margin="16dp"
        app:layout_constraintStart_toStartOf="@id/tvEditPhone"
        app:layout_constraintTop_toBottomOf="@id/tvEditPhone"
        android:background="@drawable/bg_rounded_input"
        android:focusable="false"
        android:clickable="false"
        />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/edtPhone"
        app:layout_constraintStart_toStartOf="@id/edtPhone"
        android:text="Email:"
        android:textSize="15dp"
        android:id="@+id/tvEmail"
        android:layout_margin="16dp"
        />
    <EditText
        android:id="@+id/edtViewEmail"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:layout_constraintStart_toStartOf="@id/tvEmail"
        app:layout_constraintTop_toBottomOf="@id/tvEmail"
        android:focusable="false"
        android:clickable="false"
        android:layout_margin="16dp"
        android:background="@drawable/bg_rounded_input"/>

    <Button
        android:id="@+id/btnAccessEditProfileUser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:backgroundTint="@color/button_temp"
        android:text="Xác nhận thay đổi thông tin"
        app:layout_constraintStart_toStartOf="@+id/edtViewEmail"
        app:layout_constraintTop_toBottomOf="@id/edtViewEmail" />

</androidx.constraintlayout.widget.ConstraintLayout>